<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catégorie et privilèges : un privilège par groupe pour pouvoir cumuler les rôles -->
    <record model="ir.module.category" id="module_is_cpi_raspberry">
        <field name="name">THEIA</field>
        <field name="sequence">100</field>
    </record>

    <record model="res.groups.privilege" id="privilege_gestionnaire_cpi_raspberry">
        <field name="name">Gestionnaire THEIA</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_is_cpi_raspberry"/>
    </record>
    <record model="res.groups.privilege" id="privilege_gestionnaire_of">
        <field name="name">Gestionnaire des OF</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_is_cpi_raspberry"/>
    </record>
    <record model="res.groups.privilege" id="privilege_gestionnaire_equipement">
        <field name="name">Gestionnaire des équipements</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_is_cpi_raspberry"/>
    </record>
    <record model="res.groups.privilege" id="privilege_gestionnaire_tables">
        <field name="name">Gestionnaire des tables</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_is_cpi_raspberry"/>
    </record>
    <record model="res.groups.privilege" id="privilege_employes_hors_production">
        <field name="name">Employés hors production</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_is_cpi_raspberry"/>
    </record>

    <record id="group_gestionnaire_cpi_raspberry" model="res.groups">
        <field name="name">Gestionnaire THEIA</field>
        <field name="comment">Gestionnaire THEIA</field>
        <field name="privilege_id" ref="privilege_gestionnaire_cpi_raspberry"/>
    </record>
    <record id="group_gestionnaire_of" model="res.groups">
        <field name="name">Gestionnaire des OF</field>
        <field name="comment">Ce groupe peut modifier le nombre d'empreintes sur les OF</field>
        <field name="privilege_id" ref="privilege_gestionnaire_of"/>
    </record>
    <record id="is_gestionnaire_equipement_group" model="res.groups">
        <field name="name">Gestionnaire des équipements</field>
        <field name="privilege_id" ref="privilege_gestionnaire_equipement"/>
    </record>
    <record id="is_gestionnaire_tables_group" model="res.groups">
        <field name="name">Gestionnaire des tables</field>
        <field name="privilege_id" ref="privilege_gestionnaire_tables"/>
    </record>
    <!-- Donne accès au menu « Habilitation Opérateur » (identifiant d'is_plastigray16 conservé pour la reprise des membres) -->
    <record id="is_employes_hors_production_group" model="res.groups">
        <field name="name">Employés hors production</field>
        <field name="privilege_id" ref="privilege_employes_hors_production"/>
    </record>
</odoo>
