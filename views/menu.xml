<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Les menus principaux de THEIA (Process, OF, Indicateurs, Paramètres, Habilitation, Autorisations) sont dans is_theia_view.xml -->

        <!-- THEIA / OF / Relevé des qt produites (is_alencon) -->
        <record id="is_releve_qt_produite_menu" model="ir.ui.menu" >
            <field name="name">Relevé des qt produites</field>
            <field name="sequence">900</field>
            <field name="parent_id" eval="ref('menu_is_of_root')"/>
            <field name="action"    ref="is_releve_qt_produite_action"/>
        </record>

        <!-- THEIA / Parc des presses (écran Owl du module) -->
        <record model="ir.actions.client" id="parc_presse_actions_client">
            <field name="name">Parc des presses</field>
            <field name="tag">is_alencon.parc_presse_registry</field>
        </record>
        <record id="parc_presse_menu" model="ir.ui.menu" >
            <field name="name">Parc des presses</field>
            <field name="sequence">39</field>
            <field name="parent_id" eval="ref('is_theia_root_menu')"/>
            <field name="action"    ref="parc_presse_actions_client"/>
        </record>

        <!-- THEIA / Équipements (menu « Outillages / Equipement » d'is_plastigray16) -->
        <menuitem id="menu_sub_main_is_equipement"     sequence="35" name="Équipements"     parent="is_theia_root_menu" />
        <menuitem id="menu_is_equipement"              sequence="10" name="Equipement"      parent="menu_sub_main_is_equipement" action="action_is_equipement" />
        <menuitem id="menu_is_equipement_presse"       sequence="20" name="Presse"          parent="menu_sub_main_is_equipement" action="action_is_equipement_presse" />
        <menuitem id="menu_is_equipement_prechauffeur" sequence="30" name="Prechauffeur"    parent="menu_sub_main_is_equipement" action="action_is_equipement_prechauffeur" />
        <record id="menu_is_equipement_type" model="ir.ui.menu" >
            <field name="name">Type equipement</field>
            <field name="sequence">90</field>
            <field name="action"    ref="action_is_equipement_type"/>
            <field name="parent_id" eval="ref('menu_sub_main_is_equipement')"/>
            <field name="group_ids" eval="[(6,0,[ref('is_gestionnaire_tables_group')])]"/>
        </record>

        <!-- THEIA / Équipements / Tables (menu « Outillages / Tables » d'is_plastigray16) -->
        <menuitem id="menu_sub_main_outillages_table"                  sequence="95" name="Tables"           parent="menu_sub_main_is_equipement"/>
        <menuitem id="menu_is_presse_puissance_table_outillages"       sequence="15" name="Puissance Presse" parent="menu_sub_main_outillages_table" action="action_is_presse_puissance_is_plastigray"/>
        <menuitem id="menu_is_presse_classe_table_outillages"          sequence="20" name="Classe Presse"    parent="menu_sub_main_outillages_table" action="action_is_presse_classe_is_plastigray"/>
        <menuitem id="menu_is_outillage_constructeur_table_outillages" sequence="20" name="Constructeur"     parent="menu_sub_main_outillages_table" action="action_is_outillage_constructeur_is_plastigray"/>

        <!-- THEIA / Paramètres / Variables utilisateurs (menu « Données techniques / Tables » d'is_plastigray16) -->
        <menuitem id="menu_is_dt_tables_98" sequence="98" name="Variables utilisateurs" parent="is_theia_parametres_menu" action="is_mem_var_action" groups="base.group_erp_manager"/>

        <!-- Employés / Badges -->
        <menuitem id="menu_is_pointage_badge" sequence="20" name="Badges" parent="hr.menu_hr_root" action="is_badge_action" />

        <!-- Utilisateurs & Sociétés -->
        <menuitem id="is_database_menu"  sequence="90" name="Sites"                   parent="base.menu_users" action="is_database_action"/>
        <menuitem id="is_res_users_menu" sequence="94" name="Historique de connexion" parent="base.menu_users" action="is_res_users_action" />

        <!-- Masquer le menu Employés aux utilisateurs -->
        <record id="hr.menu_hr_root" model="ir.ui.menu" >
            <field name="group_ids" eval="[(6,0,[
                ref('base.group_system'),
                ref('hr.group_hr_user'),
            ])]"/>
        </record>
    </data>
</odoo>
