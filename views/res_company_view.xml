<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Fusion des vues société d'is_plastigray16 et d'is_alencon (même identifiant is_view_company_form dans les deux modules) -->
        <record id="is_view_company_form" model="ir.ui.view">
            <field name="name">is_view_company_form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form" />
            <field name="arch" type="xml">

                <xpath expr="//sheet[1]" position="inside">
                    <style>
                        .o_form_label{
                            white-space: nowrap;
                        }
                    </style>
                </xpath>

                <notebook position="inside">
                    <page string="THEIA" name="is_theia">
                        <group>
                            <group string="Multi-coeurs">
                                <field name="is_nb_threads"/>
                            </group>
                            <group string="Programmes externes">
                                <field name="is_url_intranet_odoo"/>
                                <field name="is_url_intranet_theia"/>
                                <field name="is_url_odoo_theia"/>
                            </group>
                        </group>
                        <group>
                            <group string="Bilan de fin d'OF">
                                <field name="is_dest_bilan_of_ids" widget="many2many_tags"/>
                            </group>
                            <group string="Étiquettes des équipements">
                                <field name="is_zebra_id" />
                            </group>
                        </group>
                    </page>
                    <page string="Indicateurs  THEIA" name="is_indicateurs_theia">
                        <group>
                            <group string="Couleurs des indicateurs">
                                <field name="is_indicateur_ids" nolabel="1" colspan="2">
                                    <list editable="bottom">
                                        <field name="sequence" widget='handle'/>
                                        <field name="indicateur"/>
                                        <field name="color" widget="color"/>
                                        <field name="limite"/>
                                    </list>
                                </field>
                            </group>
                            <group string="affichage des indicateurs">
                                <field name="is_affichage_indicateur_ids" nolabel="1" colspan="2">
                                    <list editable="bottom">
                                        <field name="sequence" widget='handle'/>
                                        <field name="etat_id"/>
                                        <field name="tx_avance"/>
                                        <field name="tx_cycle"/>
                                        <field name="tx_fct"/>
                                        <field name="tx_rebut"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                        <group>
                            <field name="is_coeff_tx_rebut_parc"/>
                            <field name="is_dossier_releve_qt_produite"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
